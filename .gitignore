# OS / editor
.DS_Store
Thumbs.db
.vscode/
.idea/

# Python
__pycache__/
*.pyc

# Godot
# Import cache and editor state: regenerated by `godot --headless --import`,
# machine-specific, and noisy in diffs.
.godot/
/godot/.godot/
*.translation

# Engine binaries. The 4.3 zip is committed on purpose so an offline sandbox
# can bootstrap; the 110 MB binary it unpacks to must never be.
Godot_v*_linux.x86_64
Godot_v*_win64.exe
Godot_v*_macos.universal

# Node (only used by the headless screenshot renderer)
node_modules/
package-lock.json

# Riset gambar dan potret kerja: dihasilkan ulang oleh
# `node tools/shot.js` / image search, tidak perlu ikut repo.
image-search/
screenshots/wip/
.tmpwork/
